<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_busca"
        android:textSize="24sp" />

    <EditText
        android:id="@+id/editPokemon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_nome_pokemon"
        android:inputType="text"
        android:singleLine="true" />

    <Button
        android:id="@+id/btnVerDetalhes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/botao_ver_detalhes" />

    <Button
        android:id="@+id/btnAbrirLista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/botao_lista" />

    <Button
        android:id="@+id/btnAbrirFavoritos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/botao_favoritos" />

</LinearLayout>