<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_mng"
    app:startDestination="@id/buscaFragment">

    <fragment
        android:id="@+id/myFragment"
        tools:layout="@layout/fragment_a"
        android:name="com.example.pokeapp.MyFragment"
        android:label="AFragment" >
        <action
            android:id="@+id/action_myFragment_to_blankFragment"
            app:destination="@id/blankFragment" />
    </fragment>
    <fragment
        android:id="@+id/blankFragment"
        tools:layout="@layout/fragment_blank"
        android:name="com.example.pokeapp.BlankFragment"
        android:label="BFragment" >
        <action
            android:id="@+id/action_blankFragment_to_myFragment"
            app:destination="@id/myFragment" />
    </fragment>
    <fragment
        android:id="@+id/buscaFragment"
        android:name="com.example.pokeapp.ui.fragments.BuscaFragment"
        android:label="fragment_busca"
        tools:layout="@layout/fragment_busca" >
        <action
            android:id="@+id/action_buscaFragment_to_listaPokemonFragment"
            app:destination="@id/listaPokemonFragment" />
        <action
            android:id="@+id/action_buscaFragment_to_favoritosFragment"
            app:destination="@id/favoritosFragment" />
    </fragment>
    <fragment
        android:id="@+id/detalhesPokemonFragment"
        android:name="com.example.pokeapp.ui.fragments.DetalhesPokemonFragment"
        android:label="fragment_detalhes_pokemon"
        tools:layout="@layout/fragment_detalhes_pokemon" >
        <action
            android:id="@+id/action_detalhesPokemonFragment_to_listaPokemonFragment"
            app:destination="@id/listaPokemonFragment" />
    </fragment>
    <fragment
        android:id="@+id/listaPokemonFragment"
        android:name="com.example.pokeapp.ui.fragments.ListaPokemonFragment"
        android:label="fragment_lista_pokemon"
        tools:layout="@layout/fragment_lista_pokemon" >
        <action
            android:id="@+id/action_listaPokemonFragment_to_detalhesPokemonFragment"
            app:destination="@id/detalhesPokemonFragment" />
    </fragment>
    <fragment
        android:id="@+id/favoritosFragment"
        android:name="com.example.pokeapp.ui.fragments.FavoritosFragment"
        android:label="fragment_favoritos"
        tools:layout="@layout/fragment_favoritos" >
        <action
            android:id="@+id/action_favoritosFragment_to_buscaFragment"
            app:destination="@id/buscaFragment" />
    </fragment>

</navigation>